// TS017 - Scientific Calculator
fn fail() {
    print("error");
    exit(1);
    return 0;
}

let cmd = read_token();
if (cmd == "sqrt") {
    let x = read_float();
    if (x < 0) { fail(); } else { print(sqrt(x)); }
} else if (cmd == "log") {
    let x = read_float();
    if (x <= 0) { fail(); } else { print(log(x)); }
} else if (cmd == "exp") {
    let x = read_float();
    let r = exp(x);
    if (is_finite(r) == 0) { fail(); } else { print(r); }
} else if (cmd == "pow") {
    let b = read_float();
    let e = read_float();
    if (e == 0) {
        print(1);
    } else if (b == 0 && e < 0) {
        fail();
    } else if (b < 0 && e != floor(e)) {
        fail();
    } else {
        let r = pow(b, e);
        if (is_finite(r) == 0) { fail(); } else { print(r); }
    }
} else if (cmd == "sin") {
    let x = read_float();
    print(sin(x));
} else if (cmd == "cos") {
    let x = read_float();
    print(cos(x));
} else if (cmd == "tan") {
    let x = read_float();
    if (abs(cos(x)) < 0.0000000001) { fail(); } else { print(tan(x)); }
} else if (cmd == "fact") {
    let n = read_int();
    if (n < 0 || n > 20) {
        fail();
    } else {
        let r = 1;
        let i = 2;
        while (i <= n) {
            r = r * i;
            i = i + 1;
        }
        print(r);
    }
}
