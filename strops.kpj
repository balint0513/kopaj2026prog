// TS015 - String Operations
let cmd = read_token();
if (cmd == "reverse") {
    let a = read_token();
    let b = read_token();
    let c = read_token();
    let d = read_token();
    print(d, c, b, a);
} else if (cmd == "fizzbuzz") {
    let n = read_int();
    let i = 1;
    while (i <= n) {
        if (i % 15 == 0) {
            print("FizzBuzz");
        } else if (i % 3 == 0) {
            print("Fizz");
        } else if (i % 5 == 0) {
            print("Buzz");
        } else {
            print(i);
        }
        i = i + 1;
    }
} else if (cmd == "weekday") {
    let n = read_int();
    if (n == 1) { print("Monday"); }
    else if (n == 2) { print("Tuesday"); }
    else if (n == 3) { print("Wednesday"); }
    else if (n == 4) { print("Thursday"); }
    else if (n == 5) { print("Friday"); }
    else if (n == 6) { print("Saturday"); }
    else if (n == 7) { print("Sunday"); }
    else { print("invalid"); }
}
